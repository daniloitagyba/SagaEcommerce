{
  "ConnectionStrings": {
    "Payments": "Host=localhost;Port=5432;Database=payments;Username=orders"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "orders.created.v1",
    "PaymentResultTopic": "payments.result.v1",
    "DeadLetterTopic": "payments.result.dlq.v1",
    "ConsumerGroup": "payments-service",
    "ClientId": "payments-service"
  },
  "MessageProcessing": {
    "MaximumAttempts": 3,
    "InitialRetryDelayMilliseconds": 250,
    "MaximumRetryDelayMilliseconds": 5000,
    "InfrastructureRetryDelayMilliseconds": 1000
  },
  "Outbox": {
    "BatchSize": 5,
    "PollIntervalMilliseconds": 500,
    "MaximumRetryDelaySeconds": 60
  },
  "PaymentRisk": {
    "DeclineScoreThreshold": 60,
    "HighValueAmount": 1000,
    "HighValueScore": 50,
    "FirstPurchaseScore": 20,
    "VelocityWindowMinutes": 5,
    "VelocityOrderThreshold": 3,
    "VelocityScore": 35,
    "AtypicalAmountMultiplier": 5,
    "AtypicalAmountScore": 30
  },
  "PaymentDecisionRequest": {
    "BootstrapServers": "localhost:9092",
    "DecisionRequestedTopic": "payments.decision-requested.v1",
    "DecisionRepliedTopic": "payments.decision-replied.v1",
    "ConsumerGroup": "payments-service-decision-request",
    "ClientId": "payments-service-decision-request"
  },
  "SchemaRegistry": {
    "Url": "http://localhost:8081"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
