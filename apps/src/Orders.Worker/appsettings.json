{
  "ConnectionStrings": {
    "Orders": "Host=localhost;Port=5432;Database=orders;Username=orders"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "orders.created.v1",
    "DeadLetterTopic": "orders.created.dlq.v1",
    "ConsumerGroup": "orders-worker",
    "ClientId": "orders-worker"
  },
  "MessageProcessing": {
    "MaximumAttempts": 3,
    "InitialRetryDelayMilliseconds": 250,
    "MaximumRetryDelayMilliseconds": 5000,
    "InfrastructureRetryDelayMilliseconds": 1000
  },
  "PaymentResultKafka": {
    "BootstrapServers": "localhost:9092",
    "PaymentResultTopic": "payments.result.v1",
    "DeadLetterTopic": "payments.result.dlq.v1",
    "ConsumerGroup": "orders-worker-payments-result",
    "ClientId": "orders-worker-payments-result"
  },
  "OrderProjectionKafka": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "orders.created.v1",
    "PaymentResultTopic": "payments.result.v1",
    "DeadLetterTopic": "orders.projection.dlq.v1",
    "ConsumerGroup": "orders-projector",
    "ClientId": "orders-projector"
  },
  "SagaOrchestration": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "orders.created.v1",
    "DecisionRequestedTopic": "payments.decision-requested.v1",
    "DecisionRepliedTopic": "payments.decision-replied.v1",
    "ReservationRequestedTopic": "inventory.reservation-requested.v1",
    "ReservationRepliedTopic": "inventory.reservation-replied.v1",
    "CommitRequestedTopic": "inventory.reservation-commit-requested.v1",
    "CommitRepliedTopic": "inventory.reservation-commit-replied.v1",
    "ReleaseRequestedTopic": "inventory.reservation-release-requested.v1",
    "ReleaseRepliedTopic": "inventory.reservation-release-replied.v1",
    "RequestConsumerGroup": "orders-saga-orchestrator",
    "ReplyConsumerGroup": "orders-saga-orchestrator-reply",
    "ClientId": "orders-saga-orchestrator",
    "SweepIntervalMilliseconds": 1000
  },
  "OrderEventStore": {
    "BootstrapServers": "localhost:9092",
    "OrderCreatedTopic": "orders.created.v1",
    "PaymentResultTopic": "payments.result.v1",
    "ConsumerGroup": "orders-event-store",
    "ClientId": "orders-event-store"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Catalog": {
    "BaseUrl": "http://localhost:5080"
  },
  "SchemaRegistry": {
    "Url": "http://localhost:8081"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
