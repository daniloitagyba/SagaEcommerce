      "providerStates": [
        {
          "name": "no order with this id exists, and the caller has the orders:read role"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer contract-test-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/orders/22222222-2222-2222-2222-222222222222"
      },
      "response": {
        "status": 404
      }
    },
