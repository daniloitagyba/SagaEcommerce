# Copy to .env for local dev - see compose/.env.example for the matching backend values.

# Storefront.Service (BFF) origin the dev proxy forwards /api/* to.
VITE_BFF_URL=http://localhost:8089

# Keycloak, reachable from the browser - not the internal keycloak:8080
# hostname other services use to talk to each other.
VITE_KEYCLOAK_URL=http://localhost:18081
VITE_KEYCLOAK_REALM=orders-lab
VITE_KEYCLOAK_CLIENT_ID=orders-storefront
