<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Property-based testing for the CRDT merge laws (commutativity,
         associativity, idempotence) - see CartItemCrdtPropertyTests, moved
         here from Cart.IntegrationTests because it has no Redis/Testcontainers
         dependency and belongs in the fast, Docker-free CI coverage gate. -->
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cart.Service\Cart.Service.csproj" />
  </ItemGroup>

</Project>
