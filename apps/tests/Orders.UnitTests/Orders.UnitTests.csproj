<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Milestone 66: property-based testing for the pricing rules. Every
         other test in this repo asserts on hand-picked examples; pricing
         is the first thing here whose interesting failures live in the
         combinations nobody thinks to write down (two campaigns stacking
         past 100%, a discount that fails to divide evenly across lines),
         which is exactly what generated inputs find. -->
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Microsoft.EntityFrameworkCore.Sqlite 10.0.4 transitively pulls
         SQLitePCLRaw.lib.e_sqlite3 2.1.11, which NuGet's own vulnerability
         audit (Milestone 59's guardrail) flags as a known high-severity
         CVE (GHSA-2m69-gcr7-jv3q) - pinned forward to a patched version. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orders.Api\Orders.Api.csproj" />
    <ProjectReference Include="..\..\src\Orders.Application\Orders.Application.csproj" />
    <ProjectReference Include="..\..\src\Orders.Domain\Orders.Domain.csproj" />
    <ProjectReference Include="..\..\src\Orders.Infrastructure\Orders.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Orders.Worker\Orders.Worker.csproj" />
    <ProjectReference Include="..\..\src\Payments.Service\Payments.Service.csproj" />
    <ProjectReference Include="..\..\src\Inventory.Service\Inventory.Service.csproj" />
  </ItemGroup>

</Project>
