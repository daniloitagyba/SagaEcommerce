# Copy this file to .env and replace the example password.
POSTGRES_PASSWORD=replace-with-a-random-local-development-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-development-password
KEYCLOAK_CLIENT_SECRET=replace-with-a-random-local-development-password
# Milestone 83: the demo shopper "customer-42" - see scripts/keycloak-configure-realm.sh.
KEYCLOAK_DEMO_CUSTOMER_PASSWORD=replace-with-a-random-local-development-password
MINIO_ROOT_PASSWORD=replace-with-a-random-local-development-password

# Keep administrative and application ports on server loopback by default.
LAB_BIND_ADDRESS=127.0.0.1
ORDERS_PORT=8088
STOREFRONT_PORT=8089
KAFKA_UI_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TOXIPROXY_ADMIN_PORT=8474
KEYCLOAK_PORT=18081
