# Copy this file to .env and replace the example password.
POSTGRES_PASSWORD=replace-with-a-random-local-development-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-development-password
KEYCLOAK_CLIENT_SECRET=replace-with-a-random-local-development-password
# Milestone 83: the demo shopper "customer-42" - see scripts/keycloak-configure-realm.sh.
KEYCLOAK_DEMO_CUSTOMER_PASSWORD=replace-with-a-random-local-development-password
MINIO_ROOT_PASSWORD=replace-with-a-random-local-development-password

# Redis durability knobs - Cart.Service treats Redis as the system-of-
# record for carts, not a cache, so these matter more here than a typical
# Redis deployment. Defaults: AOF on (fsync'd every second - at most ~1s of
# writes lost on a crash), periodic RDB snapshots off (AOF alone is enough
# for this workload, and skips the fork-and-dump latency spike RDB causes
# on every save interval). REDIS_SAVE takes Redis's own "--save" syntax,
# e.g. "3600 1 300 100" to re-enable snapshotting.
REDIS_SAVE=
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# Keep administrative and application ports on server loopback by default.
# Set to 0.0.0.0 to reach the stack from another device on the same LAN
# (e.g. a phone) - if you do, also set PUBLIC_KEYCLOAK_URL below.
LAB_BIND_ADDRESS=127.0.0.1
ORDERS_PORT=8088
STOREFRONT_PORT=8089
KAFKA_UI_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TOXIPROXY_ADMIN_PORT=8474
KEYCLOAK_PORT=18081
ALERTMANAGER_PORT=9093
# Only bound when the "cdc" profile is up - see docs/messaging/milestone-21-debezium-cdc.md.
DEBEZIUM_PORT=8083
# TLS-terminating counterparts of STOREFRONT_PORT/KEYCLOAK_PORT above
# (nginx's storefront-tls.conf/keycloak-tls.conf) - only relevant for LAN
# access, see PUBLIC_KEYCLOAK_URL/PUBLIC_STOREFRONT_URL below.
STOREFRONT_TLS_PORT=8443
KEYCLOAK_TLS_PORT=18443
# Name-based HTTPS routing (compose/nginx/domains.conf) for
# *.sagaecommerce.local - only meaningful with per-client /etc/hosts
# entries pointing each name at this host's LAN IP (no LAN-wide DNS server
# here by design). Leave at the standard 80/443 unless something else on
# the host already owns them.
DOMAINS_HTTP_PORT=80
DOMAINS_HTTPS_PORT=443

# The address a shopper's own browser can reach Keycloak at - baked into
# storefront-web's build (VITE_KEYCLOAK_URL) and trusted as a second valid
# token issuer (Authentication:AlternateAuthority) by every service that
# validates JWTs, alongside the internal "http://keycloak:8080" every
# service already trusts. Leave unset for local-only use (defaults to
# http://127.0.0.1:18081, matching KEYCLOAK_PORT above).
#
# Prefer https://keycloak.sagaecommerce.local (compose/nginx/domains.conf,
# once a client resolves that name via /etc/hosts - see DOMAINS_HTTP_PORT/
# DOMAINS_HTTPS_PORT above) over the raw https://<your-LAN-IP>:18443
# (KEYCLOAK_TLS_PORT) form below - same secure-context requirement, no port
# number to remember.
#
# For phone/LAN access, use https://<your-LAN-IP>:18443 (KEYCLOAK_TLS_PORT
# above), not the plain-http :18081 port: Chrome only grants a secure
# context (window.isSecureContext) to https://, localhost, or 127.0.0.1 -
# never a plain-HTTP LAN IP - and the storefront's OIDC/PKCE login needs
# window.crypto.subtle, which only exists in a secure context. Without
# https here, "Sign in" (and "Add to cart" while signed out) does nothing
# at all: the PKCE code_challenge call throws inside oidc-client-ts and the
# failure is swallowed silently, no console error, no redirect. Run
# scripts/generate-lab-tls-cert.sh <your-LAN-IP> once before using this,
# alongside LAB_BIND_ADDRESS=0.0.0.0.
# Must be reachable by the browser, not by other containers - it's fine
# that other services can't route to it.
PUBLIC_KEYCLOAK_URL=
# Prefer https://storefront.sagaecommerce.local over the raw
# https://<your-LAN-IP>:8443 form below, for the same reason as
# PUBLIC_KEYCLOAK_URL above.
#
# The address a phone/other LAN device can reach storefront-web at, e.g.
# https://<your-LAN-IP>:8443 (STOREFRONT_TLS_PORT above, for the same
# secure-context reason as PUBLIC_KEYCLOAK_URL) - added to
# orders-storefront's Keycloak redirectUris/webOrigins by
# scripts/keycloak-configure-realm.sh so the PKCE login redirect back from
# Keycloak is accepted from that origin too. Only meaningful alongside
# PUBLIC_KEYCLOAK_URL above.
PUBLIC_STOREFRONT_URL=

# Storefront.Service's GET /api/products/summary fans out to Catalog and
# Inventory in parallel and waits for both, so tail latency is at least as
# bad as the slower of the two. INVENTORY_PROXY_BASE_URL is where the
# Inventory leg is sent; PRODUCT_SUMMARY_HEDGE_DELAY_MS > 0 fires a second
# request to Inventory if the first hasn't answered within that delay,
# taking whichever wins first - 0 (default) disables hedging.
INVENTORY_PROXY_BASE_URL=http://inventory-service:8080
PRODUCT_SUMMARY_HEDGE_DELAY_MS=0
